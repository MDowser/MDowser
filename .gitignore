# Rust build artifacts.
target/
# Multi-OS packaged output (scripts/build-dist.sh).
dist/
# Flatpak build output and vendored cargo sources (scripts/build-flatpak.sh).
# The wrapper builds under dist/ (already ignored); these cover a manual
# flatpak-builder run from the repository root.
.flatpak-builder/
packaging/flatpak/.build-dir/
packaging/flatpak/cargo-sources.json
# sync-builtin-sites.sh stages next to the asset for an atomic rename.
assets/.builtin_sites-*
# Local editor / OS config.
.vscode/
.idea/
*.swp
.DS_Store
# CI: intentionally not versioned, with ONE exception (see AGENTS.md): the
# release workflow. Everything else under .github/ stays ignored.
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/release.yml
# opencode / OpenChamber plans and agent scratch files.
.opencode/
.openchamber/
# Other AI tooling scratch dirs.
.claude/
.codex/
.cursor/
.aider*
# Local secrets and logs.
.env
.env.*
!.env.example
*.log
